.opts{display:grid;gap:10px;margin:8px 0}
.opt{display:flex;align-items:center;gap:12px;min-height:52px;padding:10px 14px;border:2px solid var(--line);border-radius:6px;background:#fff;cursor:pointer}
.opt input{width:24px;height:24px;flex:none;margin:0;accent-color:var(--blue-dark)}
.opt:has(input:checked){background:var(--blue-20);border-color:var(--blue-dark);border-width:3px;padding:9px 13px}
.opt:has(input:focus-visible){outline:3px solid var(--ink);outline-offset:2px}
.opt.ok{background:var(--green);border-color:var(--ink)}
.opt.try{background:var(--yellow-20);border-color:var(--ink)}
.pills{display:flex;flex-wrap:wrap;gap:10px}
.pills .opt{flex:1 1 220px}
.chk{display:flex;gap:12px;align-items:flex-start;min-height:48px;padding:8px 0;cursor:pointer}
