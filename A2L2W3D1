.arrow{display:none}
@media(min-width:900px){.arrow{display:flex;align-items:center;justify-content:center}.arrow::before{content:"";width:0;height:0;border-top:14px solid transparent;border-bottom:14px solid transparent;border-left:20px solid var(--ink)}}
.locknote{background:var(--grey-light);border-radius:6px;padding:8px 12px}
