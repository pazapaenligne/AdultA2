<a class="skip" href="#app">Skip to the activity</a>
<header class="top">
  <div class="brandrow">
    <img class="logo" data-img="logo" alt="Pazapa">
    <div>
      <p class="kicker">Adult English A2 &middot; Week 3 &middot; Lesson 1</p>
      <p class="title">What do I need to do?</p>
    </div>
  </div>
  <p class="mode">Review, improve and retry</p>
</header>
<div class="railwrap"><nav aria-label="Review sections"><ol class="rail" id="rail"></ol></nav></div>
<noscript><p style="padding:16px">This activity needs JavaScript.</p></noscript>
<main id="app" tabindex="-1"></main>
<div class="sr-only" id="live" role="status" aria-live="polite" aria-atomic="true"></div>

<template id="tpl">

<!-- ===== 1. Recall a phrase (scene + notebook) ===== -->
<section class="view scene" id="v1" aria-labelledby="h1">
  <figure class="scenefig">
    <img data-img="deskA" alt="Two women at an HR desk. A passport, an ID card and a checklist float above them.">
    <figcaption class="bubble">What can you say now?</figcaption>
  </figure>
  <div class="notebook">
    <h2 id="h1" tabindex="-1">Recall a phrase</h2>
    <p class="lead">You are back at the HR desk. Say what you remember before you look at any help.</p>
    <p class="small muted">Your answer can be different if it does the same job. Nothing here is marked.</p>
    <ol class="notes" id="notes"></ol>
  </div>
</section>

<!-- ===== 2. Check the detail (timeline) ===== -->
<section class="view" id="v2" aria-labelledby="h2" hidden>
  <h2 id="h2" tabindex="-1">Check the detail</h2>
  <p class="lead">Three short actions. Try first. The help and the text appear when you ask.</p>
  <ol class="tl">
    <li class="station" aria-labelledby="st1h">
      <span class="pin" aria-hidden="true">1</span>
      <h3 id="st1h">Look at the situation</h3>
      <div class="stgrid">
        <img data-img="deskB" alt="Two women at a desk. Speech bubbles show a question mark, a calendar and a payment card.">
        <fieldset id="sitSet">
          <legend>What is happening in this scene?</legend>
          <div class="opts" id="sitOpts"></div>
          <p class="fb" id="sitFb" aria-live="polite"></p>
        </fieldset>
      </div>
    </li>

    <li class="station" aria-labelledby="st2h">
      <span class="pin" aria-hidden="true">2</span>
      <h3 id="st2h">Listen, then say it</h3>
      <div id="audioListen"></div>
      <p class="tag cur">Written route</p>
      <p class="small">This is a written recall task. It is not a listening check.</p>
      <label class="lbl" for="listenIn">At the HR desk, someone says what you need to bring. Which two things can you remember?</label>
      <input type="text" id="listenIn" autocomplete="off" autocapitalize="off" spellcheck="false">
      <div class="row">
        <button class="btn help small" id="listenHint" type="button">Give me a hint</button>
        <button class="btn small" id="listenShow" type="button" disabled>Show the line</button>
      </div>
      <div class="hint" id="listenHints" aria-live="polite"></div>
      <div id="listenReveal" hidden>
        <p class="model"><span>The line</span>“You need to bring your passport and two photos.”</p>
        <p class="fb" id="listenFb" aria-live="polite"></p>
      </div>

      <div class="sub">
        <h4>Say one phrase</h4>
        <p class="quote" id="pronPhrase"></p>
        <div id="audioPron"></div>
        <p class="small">Say the phrase aloud. Then compare it with the model.</p>
        <label class="chk"><input type="checkbox" id="pronSaid"><span>I said the phrase aloud.</span></label>
        <label class="chk"><input type="checkbox" id="pronCmp"><span>I compared it with the model.</span></label>
        <details>
          <summary class="btn two small" style="display:inline-flex;align-items:center">Record myself (optional)</summary>
          <div id="recPron"></div>
        </details>
        <p class="small muted">Self-check only. Nothing in this activity judges your pronunciation.</p>
      </div>
    </li>

    <li class="station" aria-labelledby="st3h">
      <span class="pin" aria-hidden="true">3</span>
