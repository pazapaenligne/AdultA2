@media(min-width:900px){.scenefig{position:sticky;top:16px}}
.scenefig img{display:block;width:100%;max-height:420px;object-fit:contain}
.scenefig .bubble{margin:14px 0 0;background:#fff;border:3px solid var(--ink);border-radius:18px 18px 18px 4px;padding:10px 16px;font-weight:800;font-family:var(--hf);font-size:1.15rem}
