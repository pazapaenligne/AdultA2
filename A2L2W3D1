    if(it.img){var im=el('img',{class:'cuepic','data-img':it.img,alt:it.imgAlt});li.appendChild(im);}
    li.appendChild(el('p',{class:'cue'},it.cue));
    li.appendChild(el('label',{class:'lbl','for':'rin'+i},'What do you say?'));
    var inp=el('input',{type:'text',id:'rin'+i,autocomplete:'off',autocapitalize:'off',spellcheck:'false'});
    li.appendChild(inp);
    var cl=el('label',{class:'chk'});var sp=el('input',{type:'checkbox',id:'rsp'+i});
    cl.appendChild(sp);cl.appendChild(el('span',null,'I said it aloud instead.'));li.appendChild(cl);
    var row=el('div',{class:'row'});
    var bh=el('button',{class:'btn help small',type:'button'},'Give me a hint');
    var bm=el('button',{class:'btn small',type:'button',disabled:''},'Show a model');
    row.appendChild(bh);row.appendChild(bm);li.appendChild(row);
    var hint=el('div',{class:'hint','aria-live':'polite'});li.appendChild(hint);
    var model=el('div',{'aria-live':'polite'});li.appendChild(model);
    var cmp=el('fieldset',{hidden:''});cmp.appendChild(el('legend',null,'Compare with your answer'));
    var cbox=el('div',{class:'opts'});cmp.appendChild(cbox);li.appendChild(cmp);
    ol.appendChild(li);

    function attempted(){return words(S.recall[i].text)>=2||S.recall[i].spoken;}
    function upd(){bm.disabled=!(attempted()||S.recall[i].hint);}
    inp.addEventListener('input',function(){S.recall[i].text=inp.value;upd();});
    sp.addEventListener('change',function(){S.recall[i].spoken=sp.checked;upd();});
    bh.addEventListener('click',function(){
      S.recall[i].hint=true;hint.textContent='';hint.appendChild(el('p',null,'Hint: '+it.partial));
      bh.disabled=true;bh.textContent='Hint shown';upd();
    });
    bm.addEventListener('click',function(){
      S.recall[i].model=true;model.textContent='';
      var m=el('p',{class:'model'});m.appendChild(el('span',null,'Model'));m.appendChild(document.createTextNode('“'+it.model+'”'));
      model.appendChild(m);cmp.hidden=false;
      radioList(cbox,'rc'+i,[{id:'same',t:'I said something similar.'},{id:'diff',t:'It was different. I will practise this one.'}],S.recall[i].cmp,function(x){S.recall[i].cmp=x.id;});
      bm.disabled=true;
    });
  });
}

/* ===== view 2: check the detail ===== */
function wireCheck(){
  // station 1: situation
  radioList($('#sitOpts'),'sit',KEYS.situation,'',function(it,lb){
    S.sit=it.id;
    $$('#sitOpts .opt').forEach(function(x){x.classList.remove('ok','try');});
    lb.classList.add(it.ok?'ok':'try');
    setFb($('#sitFb'),it.ok?'ok':'try',it.ok?'Yes. She is asking about a process: what she needs to do.':'Not yet. Look again at the question mark, the calendar and the card.');
  });

  // station 2: listening (written route) + pronunciation
  audioSlot($('#audioListen'),CONFIG.audio.listen,'Model listening');
  var li=$('#listenIn'),lh=$('#listenHint'),ls=$('#listenShow');
  function updL(){ls.disabled=!(words(li.value)>=1||S.listen.hint);}
  li.addEventListener('input',function(){S.listen.text=li.value;updL();});
  lh.addEventListener('click',function(){S.listen.hint=true;printHints($('#listenHints'),[KEYS.listen.hint],1);lh.disabled=true;lh.textContent='Hint shown';updL();});
  ls.addEventListener('click',function(){
    S.listen.shown=true;$('#listenReveal').hidden=false;
    var n=norm(S.listen.text);
    var ok=/passport/.test(n)&&/\b(2|two)?\s?photos?\b/.test(n);
    setFb($('#listenFb'),ok?'ok':'note',ok?'Yes. Your answer matches the line: passport and two photos.':'Compare your answer with the line. The two things are a passport and two photos.');
    ls.disabled=true;
  });
  $('#pronPhrase').textContent='“'+KEYS.pron.phrase+'”';
  audioSlot($('#audioPron'),CONFIG.audio.pron,'Model phrase');
  $('#pronSaid').addEventListener('change',function(){S.pron.said=this.checked;});
  $('#pronCmp').addEventListener('change',function(){S.pron.cmp=this.checked;});
  makeRecorder($('#recPron'),'Recording for the phrase');

  // station 3: reading recall
  var ri=$('#readIn'),rh=$('#readHint'),rs=$('#readShow');
  function updR(){rs.disabled=!(words(ri.value)>=1||S.read.hint>0)||S.read.shown;}
  ri.addEventListener('input',function(){S.read.text=ri.value;updR();});
  rh.addEventListener('click',function(){
    if(S.read.hint<KEYS.read.hints.length)S.read.hint++;
    printHints($('#readHints'),KEYS.read.hints,S.read.hint);
    if(S.read.hint>=KEYS.read.hints.length){rh.disabled=true;rh.textContent='No more hints';}else rh.textContent='Another hint';
    updR();
  });
  rs.addEventListener('click',function(){
    S.read.shown=true;$('#readReveal').hidden=false;
    var ev=$('#evidence');ev.textContent='';
    var t=KEYS.read.text,k=KEYS.read.mark,p=t.indexOf(k);
    ev.appendChild(document.createTextNode(t.slice(0,p)));ev.appendChild(el('mark',null,k));ev.appendChild(document.createTextNode(t.slice(p+k.length)));
    var n=norm(S.read.text);
    var day=/\btuesday\b/.test(n),time=/\b(ten|10)(:00)?\b/.test(n);
    if(day&&time)setFb($('#readFb'),'ok','Yes. The text says Tuesday at ten.');
    else if(day||time)setFb($('#readFb'),'try','Close. Check both the day and the time in the highlighted words.');
    else setFb($('#readFb'),'note','Look at the highlighted words: Tuesday at ten.');
    radioList($('#readHowOpts'),'how',[{id:'rem',t:'I remembered it.'},{id:'found',t:'I found it again in the text.'}],S.read.how,function(x){S.read.how=x.id;});
    rs.disabled=true;
  });
}

/* ===== view 3: repair ===== */
function wireRepair(){
  var R=KEYS.repair;
  $('#draftLine').textContent=R.draft;
  var inp=$('#repairIn');inp.value=R.draft;
  var bc=$('#repairCheck'),bh=$('#repairHint'),bs=$('#repairShow');
  function isAcc(t){return R.accept.indexOf(normEnd(t))>=0;}
  function showRepair(){
    S.repair.shown=true;
    $('#repairModel').hidden=false;$('#repairModelText').textContent='“'+R.model+'”';
    $('#recreate').hidden=false;
    bs.disabled=true;
  }
  inp.addEventListener('input',function(){S.repair.text=inp.value;});
  bc.addEventListener('click',function(){
    var t=inp.value.trim(),n=normEnd(t);
    S.repair.checked=true;bs.disabled=false;
    if(isAcc(t)){S.repair.ok=true;setFb($('#repairFb'),'ok','Yes. That is a correct repair.');showRepair();}
    else if(n===normEnd(R.draft))setFb($('#repairFb'),'try','This is still the first draft. Change one small thing.');
    else if(words(t)<4)setFb($('#repairFb'),'try','Write the whole sentence.');
    else setFb($('#repairFb'),'try','Not yet. Read it slowly: need … bring. What small word is missing?');
  });
  bh.addEventListener('click',function(){
    if(S.repair.hint<R.hints.length)S.repair.hint++;
    printHints($('#repairHints'),R.hints,S.repair.hint);
    bs.disabled=false;
    if(S.repair.hint>=R.hints.length){bh.disabled=true;bh.textContent='No more hints';}else bh.textContent='Another hint';
  });
  bs.addEventListener('click',showRepair);
  var tog=$('#modelToggle'),ri=$('#recreateIn'),rc=$('#recreateCheck');
  tog.addEventListener('click',function(){
    var hide=tog.getAttribute('aria-expanded')==='true';
    $('#repairModel').hidden=hide;
    tog.setAttribute('aria-expanded',hide?'false':'true');
    tog.textContent=hide?'Show the model again':'Hide the model';
    S.repair.hidden=hide;
    if(hide){ri.disabled=false;rc.disabled=false;ri.focus();}
  });
  ri.addEventListener('input',function(){S.repair.recText=ri.value;});
  rc.addEventListener('click',function(){
    var t=ri.value.trim();
    if(words(t)<4){setFb($('#recreateFb'),'try','Write the whole sentence.');return;}
    if(isAcc(t)){S.repair.recOk=true;setFb($('#recreateFb'),'ok','Yes. You wrote the repair from memory.');}
    else setFb($('#recreateFb'),'try','Not yet. Think of need + to + bring. You can show the model again.');
  });
}

/* ===== view 4: reply studio ===== */
function wireStudio(){
  var firstIn=$('#firstIn'),firstSp=$('#firstSp'),firstSave=$('#firstSave');
  var secondIn=$('#secondIn'),secondSp=$('#secondSp'),copyFirst=$('#copyFirst');
  var recFirst=makeRecorder($('#recFirst'),'Recording for the first reply');
  var recSecond=makeRecorder($('#recSecond'),'Recording for the improved reply');
  if(typeof window.PAZAPA_STEP6_ATTEMPT==='string'&&window.PAZAPA_STEP6_ATTEMPT.trim()){
    $('#priorBox').hidden=false;
    $('#priorUse').addEventListener('click',function(){
      firstIn.value=window.PAZAPA_STEP6_ATTEMPT.trim().slice(0,300);firstIn.dispatchEvent(new Event('input'));firstIn.focus();
    });
  }
  function firstReady(){return words(firstIn.value)>=2||firstSp.checked;}
  function updFirst(){firstSave.disabled=S.first.saved||!firstReady();}
  firstIn.addEventListener('input',updFirst);
  firstSp.addEventListener('change',updFirst);
  function updSecond(){
    var open=S.first.saved,chosen=!!S.imp;
    $('#secondLock').disabled=!open;
    $('#lockNote').hidden=open;
    $('#possible').hidden=!open;
    $('#secondTools').hidden=!(open&&chosen);
    copyFirst.disabled=!S.first.text;
    updAfter();
  }
  function retryAttempt(){return words(S.second.text)>=2||S.second.spoken;}
  function updAfter(){$('#after').hidden=!(S.first.saved&&S.imp&&retryAttempt());}
  firstSave.addEventListener('click',function(){
    if(!firstReady())return;
    S.first={text:firstIn.value.trim().slice(0,300),spoken:firstSp.checked,saved:true};
    firstIn.readOnly=true;firstIn.setAttribute('aria-readonly','true');firstSp.disabled=true;
    $('#priorUse').disabled=true;
    recFirst.stopIfRecording();recFirst.setLocked(true);
    firstSave.disabled=true;
    setFb($('#firstFb'),'ok','First reply saved. It stays on the left so you can compare.');
    updSecond();
    say('First reply saved. The improved reply side is open.');
  });
  radioList($('#impPills'),'imp',KEYS.improve,'',function(it){
    S.imp=it.id;
    var ex=$('#impExample');ex.textContent='';
    var m=el('p',{class:'model'});m.appendChild(el('span',null,'Example for: '+it.t));m.appendChild(document.createTextNode('“'+it.ex+'”'));
    ex.appendChild(m);
    updSecond();
    radioList($('#clearOpts'),'clear',KEYS.improve.concat([{id:'unsure',t:'I am not sure yet. I will practise.'}]),S.clear,function(x){S.clear=x.id;});
  });
  secondIn.addEventListener('input',function(){
    S.second.text=secondIn.value;
    if(words(secondIn.value)>=2&&normEnd(secondIn.value)===normEnd(S.first.text))setFb($('#secondFb'),'try','This is the same as your first reply. Change one thing.');
    else setFb($('#secondFb'),'','');
    updAfter();
  });
  secondSp.addEventListener('change',function(){S.second.spoken=secondSp.checked;updAfter();});
  copyFirst.addEventListener('click',function(){
    if(secondIn.value.trim()){say('Your improved reply already has text. Change it or add to it.');secondIn.focus();return;}
    secondIn.value=S.first.text;secondIn.dispatchEvent(new Event('input'));secondIn.focus();
  });
  $$('#after input[data-sc]').forEach(function(c){c.addEventListener('change',function(){S.sc[c.getAttribute('data-sc')]=c.checked;});});
  updFirst();updSecond();
}

/* ===== view 5: transfer ===== */
function wireTransfer(){
  var inp=$('#trIn'),bh=$('#trHint'),bs=$('#trShow');
  var H=KEYS.transfer.hints;
  function upd(){bs.disabled=S.tr.shown||!(words(inp.value)>=2||S.tr.hint>0);$('#trSelf').hidden=!(words(S.tr.text)>=3||S.tr.shown);}
  inp.addEventListener('input',function(){S.tr.text=inp.value;upd();});
  bh.addEventListener('click',function(){
    if(S.tr.hint<H.length)S.tr.hint++;
    printHints($('#trHints'),H,S.tr.hint);
    if(S.tr.hint>=H.length){bh.disabled=true;bh.textContent='No more hints';}else bh.textContent='Another hint';
    upd();
  });
  bs.addEventListener('click',function(){S.tr.shown=true;$('#trReveal').hidden=false;upd();});
  $$('#trSelf input[data-tr]').forEach(function(c){c.addEventListener('change',function(){S.tr[c.getAttribute('data-tr')]=c.checked;});});
}

/* ===== view 6: finish + completion ===== */
function criteria(){
  var recall=S.recall.some(function(r){return words(r.text)>=2||r.spoken;});
  var point=S.read.shown||S.repair.shown||S.repair.ok||S.repair.recOk;
  var secondOk=S.first.saved&&((words(S.second.text)>=2&&normEnd(S.second.text)!==normEnd(S.first.text))||S.second.spoken);
  var trOk=words(S.tr.text)>=3;
  return {recall:recall,point:point,retry:!!(secondOk||trOk)};
}
var completionInFlight=false, completionSent=false;
function renderFinish(){
  var c=criteria(),list=$('#sumList');list.textContent='';
  [{k:'recall',t:'You tried to recall a phrase.',todo:'Try to recall a phrase.',go:0,gl:'Recall a phrase'},
   {k:'point',t:'You checked or repaired one point.',todo:'Check the detail or repair one point.',go:1,gl:'Check the detail'},
   {k:'retry',t:'You tried your reply again.',todo:'Write an improved reply or try the new detail.',go:3,gl:'Compare my replies'}].forEach(function(r){
    var li=el('li');
    li.appendChild(el('span',{class:'st'+(c[r.k]?' yes':'')},c[r.k]?'Done':'Still to do'));
    li.appendChild(el('span',null,c[r.k]?r.t:r.todo));
    if(!c[r.k]){var b=el('button',{class:'btn two small',type:'button'},'Go to: '+r.gl);b.addEventListener('click',function(){show(r.go);});li.appendChild(b);}
    list.appendChild(li);
  });
  radioList($('#nextOpts'),'next',KEYS.next,S.next,function(x){S.next=x.id;showGoal();});
  showGoal();
  updDone();
}
function showGoal(){
  var g=$('#goalBox'),it=KEYS.next.filter(function(x){return x.id===S.next;})[0];
  if(it){g.hidden=false;g.textContent='My practice goal: '+it.t;}else g.hidden=true;
}
function updDone(){
  var c=criteria(),ok=c.recall&&c.point&&c.retry;
  $('#doneBtn').disabled=!ok||completionInFlight;
  $('#finishNote').textContent=ok?'You can press Done when you are ready.':'Finish the steps marked “Still to do” to turn on Done.';
}

/* ----- LMS (SCORM 1.2 and 2004) ----- */
var lms={api:null,ver:null,ready:false,tries:0};
function findApi(name){
  var wins=[window];try{if(window.opener)wins.push(window.opener);}catch(e){}
  for(var k=0;k<wins.length;k++){
    var w=wins[k],d=0;
    while(w&&d<12){
      try{if(w[name])return w[name];}catch(e){}
      try{if(w.parent&&w.parent!==w)w=w.parent;else break;}catch(e){break;}
      d++;
    }
  }
  return null;
}
function lmsConnect(){
  if(lms.ready||lms.tries>6)return lms.ready;
  lms.tries++;
  try{
    var a=findApi('API_1484_11');
    if(a){var ok=a.Initialize('');if(ok===true||ok==='true'){lms.api=a;lms.ver='2004';lms.ready=true;}}
    else{a=findApi('API');if(a){var ok2=a.LMSInitialize('');if(ok2===true||ok2==='true'){lms.api=a;lms.ver='1.2';lms.ready=true;}}}
  }catch(e){lms.ready=false;}
  return lms.ready;
}
function lmsGet(k){try{var v=(lms.ver==='2004')?lms.api.GetValue(k):lms.api.LMSGetValue(k);return String(v==null?'':v);}catch(e){return '';}}
function lmsSet(k,v){try{var r=(lms.ver==='2004')?lms.api.SetValue(k,v):lms.api.LMSSetValue(k,v);return r===true||r==='true';}catch(e){return false;}}
function lmsCommit(){try{var r=(lms.ver==='2004')?lms.api.Commit(''):lms.api.LMSCommit('');return r===true||r==='true';}catch(e){return false;}}
function lmsCompleted(){
  if(!lms.ready)return false;
  if(lms.ver==='2004')return lmsGet('cmi.completion_status')==='completed';
  var v=lmsGet('cmi.core.lesson_status');return v==='completed'||v==='passed';
}
function commitCompletion(){
  // returns true only when the commit is confirmed (or when there is no LMS and completion is local)
  if(!lmsConnect())return true;
  if(lmsCompleted())return true;
  var a,b;
  if(lms.ver==='2004'){a=lmsSet('cmi.completion_status','completed');b=lmsSet('cmi.exit','');lmsSet('cmi.progress_measure','1');}
  else{a=lmsSet('cmi.core.lesson_status','completed');b=lmsSet('cmi.core.exit','');}
  var c=lmsCommit();
  return !!(a&&c);
}
function finish(){
  var c=criteria();
  if(!(c.recall&&c.point&&c.retry)||current!==5)return;
  var btn=$('#doneBtn');
  if(completionSent){btn.textContent='Done ✓';say('Your review is finished.');return;}
  if(completionInFlight)return;
  completionInFlight=true;btn.disabled=true;
  var ok=false;
  try{ok=commitCompletion();}catch(e){ok=false;}
  completionInFlight=false;
  if(ok){
    completionSent=true;
    try{if(CONFIG.parentOrigin&&window.parent&&window.parent!==window)window.parent.postMessage({type:'pazapa-activity-completed',activity:CONFIG.activityId},CONFIG.parentOrigin);}catch(e){}
    btn.textContent='Done ✓';
    say('Your review is finished.');
  }else{
    btn.disabled=false;       // allow another try; no duplicate success was recorded
    say('Done did not finish. Press Done again.');
  }
}

/* ===== mount / reset ===== */
function mount(){
  recs.forEach(function(r){r.destroy();});recs=[];
  stopPlayback();
  var app=$('#app');app.textContent='';
  app.appendChild($('#tpl').content.cloneNode(true));
  S=fresh();current=0;
  fillImages(app);
  wireRecall();wireCheck();wireRepair();wireStudio();wireTransfer();
  fillImages(app);
  addPagers();
  $('#doneBtn').addEventListener('click',finish);
  $('#againBtn').addEventListener('click',function(){mount();window.scrollTo(0,0);var h=$('#h1');if(h)h.focus();say('The review is ready to try again.');});
  show(0);
}

(function init(){
  if(lmsConnect()&&lmsCompleted())completionSent=true;   // restore confirmed completion
  fillImages(document);                                   // logo in the header
  mount();
})();
window.addEventListener('pagehide',function(){
  recs.forEach(function(r){r.destroy();});
  try{if(lms.ready){if(lms.ver==='2004')lms.api.Terminate('');else lms.api.LMSFinish('');}}catch(e){}
});
})();
</script>
