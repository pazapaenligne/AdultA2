/* COMPOSITION 5: case slip */
.slipwrap{display:grid;gap:26px;grid-template-columns:1fr;margin-top:16px}
@media(min-width:880px){.slipwrap{grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr);align-items:start}}
